{
  "name": "umean",
  "version": "0.3.0",
  "description": "TipTap WYSIWYG editor core — Web, Electron & TenTap",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./tentap": {
      "types": "./dist/tentap/index.d.ts",
      "import": "./dist/tentap/index.js"
    },
    "./tentap/editor-html": {
      "import": "./tentap/editor-web/build/editorHtml.ts"
    },
    "./styles/rich.css": "./styles/rich.css",
    "./styles/rich-minimal.css": "./styles/rich-minimal.css"
  },
  "files": [
    "dist",
    "styles",
    "tentap/editor-web"
  ],
  "scripts": {
    "build": "rolldown -c rolldown.lib.config.ts && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build:test": "rolldown -c rolldown.test.config.ts",
    "dev": "concurrently -k \"rolldown -c rolldown.lib.config.ts --watch\" \"tsc --emitDeclarationOnly --watch\" \"rolldown -c rolldown.test.config.ts --watch\" \"serve . -l 5173\"",
    "dev:lib": "concurrently -k \"rolldown -c rolldown.lib.config.ts --watch\" \"tsc --emitDeclarationOnly --watch\"",
    "test:dev": "concurrently -k \"rolldown -c rolldown.lib.config.ts --watch\" \"tsc --emitDeclarationOnly --watch\" \"rolldown -c rolldown.test.config.ts --watch\" \"serve . -l 5173\"",
    "test:open": "npm run build && npm run build:test && serve . -l 5173",
    "editor:dev": "vite --config tentap/editor-web/vite.config.ts",
    "editor:build": "vite --config tentap/editor-web/vite.config.ts build && node tentap/scripts/post-build.mjs",
    "demo:tentap": "npm run editor:build && npm --prefix examples/tentap-demo start",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run editor:build"
  },
  "keywords": [
    "tiptap",
    "wysiwyg",
    "editor",
    "json",
    "markdown",
    "tentap",
    "react-native",
    "electron"
  ],
  "author": "youmean <zhaoyumin@youmean.cn>",
  "repository": {
    "type": "git",
    "url": "git+https://cnb.cool/youmean/share/umean/umean.git"
  },
  "bugs": {
    "url": "https://cnb.cool/youmean/share/umean/umean/-/issues"
  },
  "homepage": "https://cnb.cool/youmean/share/umean/umean",
  "license": "MIT",
  "dependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-code-block-lowlight": "^3.27.3",
    "@tiptap/extension-image": "^3.27.3",
    "@tiptap/extension-highlight": "^3.27.3",
    "@tiptap/extension-horizontal-rule": "^3.27.3",
    "@tiptap/extension-link": "^3.27.3",
    "@tiptap/extension-mathematics": "^3.27.3",
    "@tiptap/extension-placeholder": "^3.27.3",
    "@tiptap/extension-table": "^3.27.3",
    "@tiptap/extension-table-cell": "^3.27.3",
    "@tiptap/extension-table-header": "^3.27.3",
    "@tiptap/extension-table-row": "^3.27.3",
    "@tiptap/extension-task-item": "^3.27.3",
    "@tiptap/extension-task-list": "^3.27.3",
    "@tiptap/markdown": "^3.27.3",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.27.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "lowlight": "^3.3.0",
    "mermaid": "^11.16.0"
  },
  "devDependencies": {
    "@10play/tentap-editor": "^1.0.1",
    "@tiptap/react": "^3.27.3",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/ui": "^3.2.7",
    "concurrently": "^9.2.0",
    "happy-dom": "^15.11.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rolldown": "^1.1.3",
    "serve": "^14.2.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@10play/tentap-editor": "^1.0.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@10play/tentap-editor": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    }
  }
}
